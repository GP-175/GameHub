{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "installCommand": "npm ci",
  "outputDirectory": "public",
  "redirects": [
    { "source": "/gp-hoot", "destination": "https://gp-hoot.gplange.tech/gp-hoot", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://gp-hoot.gplange.tech/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://gp-hoot.gplange.tech/uploads/:path*" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }] },
    { "source": "/api/:path*", "headers": [{ "key": "Cache-Control", "value": "private, no-store" }] },
    { "source": "/assets/:path*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/games/:path*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
  ]
}
